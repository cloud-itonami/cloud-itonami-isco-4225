;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: inquiry clerks (ISCO 4225) are a Wave-0 cognitive occupation (no
;; robotics gate); blueprint.edn declares :itonami.blueprint/robotics true.
;; The physical edge of an inquiry desk is handing leaflets and forms across
;; the counter, and walking an enquirer to the right office. These cases
;; declare that edge.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4225"
 :cases
 [{:id :leaflet-handoff
   :kind :manipulator
   :procedure "desktop arm takes a leaflet bundle from the rack and holds it out across the counter to the enquirer"
   :params {:l1-m 0.30 :l2-m 0.25 :m1-kg 1.5 :m2-kg 1.0
            :from [0.15 0.40] :to [0.50 0.10] :duration-s 1.0 :steps 300}
   :sweep {:param :payload-kg :values [0.1 0.3 0.6 1.0 2.0]}
   :quantity :peak-tau1-nm
   :limit {:max 15.0 :basis "estimate: continuous shoulder torque of a desktop arm (~1-3 kg class)"}
   :boundary {:lo 0.02 :hi 8.0}}
  {:id :enquirer-guide-to-office
   :kind :transport
   :procedure "robot walks an enquirer from the inquiry desk to the office that handles their question"
   :params {:mass-kg 45.0 :payload-kg 0.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 0.6 :drive-force-n 90.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.25}
   :sweep {:param :distance-m :values [15.0 30.0 50.0 80.0 120.0]}
   :quantity :cycle-time-s
   :limit {:max 100.0 :basis "estimate: the desk may be unattended for at most about 3.5 minutes per guided round trip"}
   :boundary {:lo 2.0 :hi 400.0}}]}
